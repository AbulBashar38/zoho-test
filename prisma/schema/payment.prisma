// A payment your backend asks Zoho to collect. All pricing and invoicing stay local; Zoho
// only hosts the payment page and confirms the money arrived.
model PaymentRequest {
  id String @id @default(uuid(7))

  // Your own identifier for the order/bill this payment settles.
  reference   String  @unique
  description String
  amount      Decimal @db.Decimal(12, 2)
  currencyCode String?

  status PaymentRequestStatus @default(PENDING)

  zohoCustomerId    String
  zohoPaymentLinkId String? @unique
  paymentLinkNumber String?
  paymentUrl        String?
  zohoPaymentId     String?
  // Set when the payment is collected through an ad-hoc Zoho invoice instead of a link.
  zohoInvoiceId     String? @unique

  expiresAt DateTime?
  paidAt    DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId], name: "idx_payment_request_userId")
  @@index([status], name: "idx_payment_request_status")
  @@index([zohoCustomerId], name: "idx_payment_request_customer")
  @@map("payment_requests")
}
