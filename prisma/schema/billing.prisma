// Local mirror of Zoho Billing records. The app reads from these tables; webhooks keep them
// current. Zoho remains the source of truth for money.
model ZohoBillingSubscription {
  id String @id @default(uuid(7))

  zohoSubscriptionId String  @unique
  zohoCustomerId     String
  planCode           String
  planName           String?
  status             String
  amount             Decimal @db.Decimal(12, 2)
  currencyCode       String?
  referenceId        String?

  startsAt        DateTime?
  nextBillingAt   DateTime?
  cancelledAt     DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  invoices ZohoBillingInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId], name: "idx_zoho_subscription_userId")
  @@map("zoho_billing_subscriptions")
}

model ZohoBillingInvoice {
  id String @id @default(uuid(7))

  zohoInvoiceId  String  @unique
  invoiceNumber  String?
  zohoCustomerId String
  status         String
  total          Decimal @db.Decimal(12, 2)
  balance        Decimal @db.Decimal(12, 2)
  currencyCode   String?
  invoiceUrl     String?

  invoiceDate DateTime?
  dueDate     DateTime?
  paidAt      DateTime?

  zohoSubscriptionId String?
  subscription       ZohoBillingSubscription? @relation(fields: [zohoSubscriptionId], references: [zohoSubscriptionId], onDelete: SetNull, onUpdate: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  payments ZohoBillingPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId], name: "idx_zoho_invoice_userId")
  @@index([status], name: "idx_zoho_invoice_status")
  @@map("zoho_billing_invoices")
}

// zohoPaymentId is unique so replayed payment_thankyou webhooks stay idempotent.
model ZohoBillingPayment {
  id String @id @default(uuid(7))

  zohoPaymentId  String  @unique
  zohoInvoiceId  String
  zohoCustomerId String
  amount         Decimal @db.Decimal(12, 2)
  paymentMode    String?
  referenceNumber String?
  gatewayFee     Decimal? @db.Decimal(12, 2)
  netAmount      Decimal? @db.Decimal(12, 2)

  paidAt DateTime?

  invoice ZohoBillingInvoice @relation(fields: [zohoInvoiceId], references: [zohoInvoiceId], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("zoho_billing_payments")
}

// Every webhook Zoho delivers, kept for debugging and replay inspection.
model ZohoWebhookEvent {
  id String @id @default(uuid(7))

  eventType String
  eventId   String? @unique
  payload   Json
  processed Boolean @default(false)
  error     String?

  receivedAt DateTime @default(now())

  @@index([eventType], name: "idx_zoho_webhook_eventType")
  @@map("zoho_webhook_events")
}
