model User {
  id                 String     @id @default(uuid())
  name               String
  email              String
  password           String
  emailVerified      Boolean    @default(false)
  role               Role       @default(PATIENT)
  status             UserStatus @default(ACTIVE)
  needPasswordChange Boolean    @default(false)
  isDeleted          Boolean    @default(false)
  deletedAt          DateTime?
  zohoContactId      String?    @unique
  // Zoho Billing keeps its own customer records, separate from Books contacts.
  zohoBillingCustomerId String? @unique
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  patient            Patient?

  billingSubscriptions ZohoBillingSubscription[]
  billingInvoices      ZohoBillingInvoice[]
  orders               Order[]

  @@unique([email])
  @@map("users")
}
